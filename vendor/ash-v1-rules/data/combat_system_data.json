    "spellcasting_rules": {
      "attacks_of_opportunity": {
        "provokes_in_melee": true,
        "trigger": "Casting spell within melee threat range",
        "interruption_on_crit_or_stun": true
      },
      "armor_restrictions": {
        "wizard": {
          "allowed_armor": "none",
          "allowed_shields": false,
          "description": "Wizard spells cannot be cast in any armor or with shields."
        },
        "druid": {
          "allowed_armor": "non_metal",
          "allowed_shields": "wooden_only",
          "description": "Druid spells cannot be cast in metal armor or with metal shields."
        },
        "cleric": {
          "allowed_armor": "all",
          "allowed_shields": true,
          "description": "Clerics may wear any armor subject to deity alignment maintenance."
        }
      },
      "cleric_deity_alignment": {
        "required_virtues_or_vices_count": 5,
        "primary_threshold": {
          "min_score": 15,
          "required_count": 3
        },
        "secondary_threshold": {
          "min_score": 11,
          "required_count": 2
        },
        "failure_effect": "Loss of divine spellcasting powers until score restoration or atonement."
      },
      "mishap_rule": {
        "trigger": "Natural 1 on d20 spell roll",
        "effect": "Spell Mishap",
        "consequence": "Cannot cast that specific spell until the next dawn."
      }
    }
