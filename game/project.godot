; Engine configuration file.
; Edit through the Godot editor where possible.
;
; Format:
;   [section]
;   parameter=value

config_version=5

[application]

config/name="AshLaw"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=400
window/size/window_width_override=1280
window/size/window_height_override=800

; "viewport" renders the game at 640x400, then displays that framebuffer at an
; initial 2x on Windows. "integer" forbids fractional scales, so letterboxing
; absorbs slack rather than distorting the pixel grid.
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Ash.Game"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

