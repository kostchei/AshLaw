<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <!--
      Stated explicitly, not inherited from Directory.Build.props, because the Godot
      editor rewrites this file and writes its own default TargetFramework (net8.0 for
      Godot 4.x) when it does. An inherited value gives it an empty slot to fill; an
      explicit one is at least a visible diff.

      A net8.0 game project referencing net10.0 libraries fails to build, and the error
      names the references rather than the framework, so it reads like a broken
      dependency or an unresolvable SDK. Build plan §0.1 flags mismatched TFMs as "a
      common source of misleading runtime load errors". This is that.

      tools/check-target-frameworks.ps1 asserts this still matches Directory.Build.props.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ash.Game</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Ash.Content\Ash.Content.csproj" />
    <ProjectReference Include="..\src\Ash.Core\Ash.Core.csproj" />
    <ProjectReference Include="..\src\Ash.Rules\Ash.Rules.csproj" />
    <ProjectReference Include="..\src\Ash.Script\Ash.Script.csproj" />
    <ProjectReference Include="..\src\Ash.Sim\Ash.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeRules Include="..\vendor\ash-v1-rules\data\*.json;..\vendor\ash-v1-rules\data\*.csv" />
    <RuntimeRules Include="..\data\character-creation.json;..\data\vitality.json" />
  </ItemGroup>

  <Target Name="StageRuntimeRules" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\assets\rules" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\assets\rules" />
    <Copy SourceFiles="@(RuntimeRules)"
          DestinationFiles="@(RuntimeRules->'$(MSBuildProjectDirectory)\assets\rules\%(Filename)%(Extension).txt')" />
  </Target>
</Project>
